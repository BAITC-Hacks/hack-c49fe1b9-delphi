# Copy to lab/.env; never commit keys. This is the OpenAI Platform API key.
OPENAI_API_KEY=
# Must be available to your API project and support Responses + structured outputs + tools.
OPENAI_MODEL=gpt-6-sol
LAB_MAX_CALLS=40
LAB_MAX_OUTPUT_TOKENS=5000
LAB_MAX_INPUT_CHARS=16000
LAB_MAX_TOOL_ROUNDS=4
LAB_TIMEOUT_SECONDS=900
# Cost tracking is built in for live runs/translations. Set 0 to disable.
LAB_COST_TRACKING=1
# Optional cumulative USD guard per run; empty keeps the original call/time limits only.
LAB_COST_BUDGET_USD=
# Resolved relative to lab; paths outside lab are rejected.
LAB_DATA_DIR=data
