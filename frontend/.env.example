# Dedicated PostgreSQL database for Better Auth. Do not point this at the
# backend's database: it owns a different users table and has no auth contract.
AUTH_DATABASE_URL=postgresql://delphi:replace-with-a-local-password@127.0.0.1:54329/delphi_frontend
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Server-only address used by the authenticated Next.js proxy. The browser
# never receives this value.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
